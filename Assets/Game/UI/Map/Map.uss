.map {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
}

.map__full {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    padding: 60px 120px;
    background-color: rgba(3, 8, 6, 0.97);
    display: none;
}

.map__full--open {
    display: flex;
}

.map__title {
    font-size: 36px;
    -unity-font-style: bold;
    letter-spacing: 4px;
}

.map__info {
    font-size: 22px;
    color: rgb(170, 240, 190);
    margin-bottom: 10px;
}

.map__legend {
    flex-direction: row;
    flex-wrap: wrap;
    margin-top: 8px;
}

.map-legend__item {
    flex-direction: row;
    align-items: center;
    margin-right: 18px;
    margin-bottom: 6px;
}

.map-legend__label {
    font-size: 17px;
    color: rgb(170, 210, 180);
}

.map__empty {
    font-size: 24px;
    color: rgb(150, 200, 170);
    -unity-text-align: middle-center;
    flex-grow: 1;
}

.map-view {
    flex-grow: 1;
}

.map__overlay {
    position: absolute;
    left: 15%;
    right: 15%;
    top: 12%;
    bottom: 12%;
    opacity: 0.6;
    display: none;
}

.map__overlay--shown {
    display: flex;
}

.map-room {
    border-width: 2px;
}

.map-room--cell {
    border-width: 0;
}

.map-marker {
    width: 16px;
    height: 16px;
    translate: -50% -50%;
    border-radius: 8px;
    border-width: 2px;
    border-color: rgba(8, 8, 10, 0.9);
}

.map-marker--nest {
    background-color: rgb(230, 80, 170);
}

.map-marker--nest-site {
    border-width: 2px;
    border-color: rgb(230, 80, 170);
}

.map-marker--relay {
    background-color: rgb(230, 60, 50);
    border-radius: 0;
    rotate: 45deg;
}

.map-marker--relay-off {
    background-color: rgb(90, 90, 90);
    border-radius: 0;
    rotate: 45deg;
}

.map-marker--door {
    width: 22px;
    height: 8px;
    border-radius: 0;
    background-color: rgb(240, 200, 60);
}

.map-marker--gate {
    width: 18px;
    height: 18px;
    border-radius: 0;
    border-width: 3px;
    border-color: rgb(230, 60, 50);
}

.map-marker--hoarder {
    background-color: rgb(80, 230, 120);
    border-color: rgb(255, 255, 255);
}

.map-marker--pickup {
    background-color: rgb(255, 210, 70);
    border-radius: 0;
    rotate: 45deg;
}

.map-marker--lore {
    background-color: rgb(255, 255, 255);
    border-color: rgb(40, 90, 220);
    border-radius: 3px;
}

.map-marker--tunnel {
    background-color: rgb(245, 160, 40);
    border-radius: 0;
}

.map-link {
    background-color: rgba(245, 160, 40, 0.7);
}

.map-marker--biomass {
    width: 18px;
    height: 18px;
    border-radius: 9px;
    background-color: rgb(255, 120, 200);
    border-width: 2px;
    border-color: rgb(255, 255, 255);
}

.map-creature {
    position: absolute;
    width: 16px;
    height: 16px;
    translate: -50% -50%;
    border-radius: 8px;
    background-color: rgb(255, 255, 255);
    border-width: 3px;
    border-color: rgb(20, 20, 20);
}

.travel {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    align-items: center;
    justify-content: center;
    background-color: rgb(30, 4, 22);
}

.travel__label {
    font-size: 30px;
    letter-spacing: 8px;
    color: rgb(240, 120, 200);
}

.map-legend__icon {
    position: relative;
    translate: 0 0;
    left: 0;
    top: 0;
    margin-right: 8px;
    flex-shrink: 0;
}
