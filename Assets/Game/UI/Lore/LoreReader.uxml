<ui:UXML xmlns:ui="UnityEngine.UIElements">
    <Style src="LoreReader.uss" />
    <ui:VisualElement name="reader" class="reader">
        <ui:VisualElement class="reader__panel">
            <ui:Label name="header" class="reader__header" />
            <ui:Label name="title" class="reader__title" />
            <ui:Label name="from" class="reader__from" />
            <ui:ScrollView name="scroll" class="reader__scroll">
                <ui:Label name="body" class="reader__body" />
            </ui:ScrollView>
            <ui:Button name="close" class="reader__close" />
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>
