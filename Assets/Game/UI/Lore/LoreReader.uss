.reader {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    align-items: center;
    justify-content: center;
    background-color: rgba(0, 4, 2, 0.8);
    display: none;
}

.reader--open {
    display: flex;
}

.reader__panel {
    width: 1000px;
    height: 820px;
    padding: 28px 36px;
    background-color: rgb(4, 14, 8);
    border-width: 2px;
    border-color: rgb(60, 200, 110);
}

.reader__header {
    font-size: 18px;
    letter-spacing: 4px;
    color: rgb(60, 200, 110);
    border-bottom-width: 2px;
    border-color: rgba(60, 200, 110, 0.4);
    padding-bottom: 6px;
    margin-bottom: 14px;
}

.reader__title {
    font-size: 30px;
    -unity-font-style: bold;
    color: rgb(150, 255, 180);
    white-space: normal;
}

.reader__from {
    font-size: 20px;
    color: rgb(90, 190, 120);
    margin-bottom: 14px;
}

.reader__scroll {
    flex-grow: 1;
}

.reader__body {
    font-size: 22px;
    color: rgb(170, 240, 190);
    white-space: normal;
}

.reader__close {
    align-self: flex-end;
    margin-top: 14px;
    height: 48px;
    width: 220px;
    font-size: 22px;
    color: rgb(170, 240, 190);
    background-color: rgb(10, 30, 18);
    border-width: 2px;
    border-color: rgb(40, 120, 70);
}

.reader__close:hover,
.reader__close:focus {
    background-color: rgb(20, 60, 34);
    border-color: rgb(60, 200, 110);
}

.toast {
    position: absolute;
    left: 0;
    right: 0;
    top: 150px;
    align-items: center;
    opacity: 0;
    transition-property: opacity;
    transition-duration: 0.25s;
}

.toast--shown {
    opacity: 1;
}

.toast__label {
    font-size: 28px;
    padding: 10px 28px;
    color: rgb(170, 240, 190);
    background-color: rgba(4, 14, 8, 0.85);
    border-width: 2px;
    border-color: rgb(60, 200, 110);
}
