<ui:UXML xmlns:ui="UnityEngine.UIElements">
    <Style src="Hoarder.uss" />
    <ui:VisualElement name="hoarder" class="hoarder">
        <ui:VisualElement class="hoarder__panel">
            <ui:Label name="title" class="hoarder__title" />
            <ui:Label name="speaker" class="hoarder__speaker" />
            <ui:Label name="line" class="hoarder__line" />
            <ui:Label name="biomass" class="hoarder__biomass" />
            <ui:ScrollView name="rows" class="hoarder__rows" />
            <ui:Button name="leave" class="hoarder__button hoarder__leave" />
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>
