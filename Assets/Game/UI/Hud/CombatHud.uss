.hud {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
}

.hud__layer {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
}

.hud__player {
    position: absolute;
    bottom: 48px;
    left: 50%;
    width: 560px;
    translate: -50% 0;
    padding: 5px;
    background-color: rgba(6, 8, 6, 0.55);
    border-left-width: 3px;
    border-right-width: 3px;
    border-color: rgb(255, 176, 0);
}

.hud-bar {
    overflow: hidden;
    background-color: rgba(10, 12, 10, 0.9);
    border-width: 1px;
    border-color: rgb(110, 84, 24);
}

.hud-bar--health {
    height: 18px;
}

.hud-bar--charge {
    height: 8px;
    margin-top: 4px;
}

.hud-bar__layer {
    position: absolute;
    left: 0;
    top: 0;
    bottom: 0;
    width: 0;
}

.hud-bar__trail {
    background-color: rgb(235, 205, 170);
}

.hud-bar__heal {
    background-color: rgb(120, 230, 70);
}

.hud-bar--health .hud-bar__fill {
    background-color: rgb(185, 28, 48);
}

.hud-bar--charge .hud-bar__fill {
    background-color: rgb(30, 160, 145);
}

.hud-bar--charge-full .hud-bar__fill {
    background-color: rgb(80, 255, 225);
}

.hud-bar__glow {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    background-color: rgb(220, 255, 250);
    opacity: 0;
}

.hud-bar__ticks {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
}

.hud-bar__tick {
    position: absolute;
    top: 0;
    bottom: 0;
    width: 1px;
    background-color: rgba(0, 0, 0, 0.45);
}

.enemy-bar {
    position: absolute;
    width: 96px;
    margin-left: -48px;
    margin-top: -16px;
}

.enemy-bar__health {
    height: 8px;
    overflow: hidden;
    background-color: rgba(10, 12, 10, 0.85);
    border-width: 1px;
    border-color: rgba(0, 0, 0, 0.9);
}

.enemy-bar__trail,
.enemy-bar__fill,
.enemy-bar__armor,
.enemy-bar__stagger-fill {
    position: absolute;
    left: 0;
    top: 0;
    bottom: 0;
    width: 0;
}

.enemy-bar__trail {
    background-color: rgb(235, 205, 170);
}

.enemy-bar__fill {
    background-color: rgb(200, 40, 40);
}

.enemy-bar--feedable .enemy-bar__fill {
    background-color: rgb(140, 255, 60);
}

.enemy-bar__armor {
    bottom: auto;
    height: 2px;
    background-color: rgb(190, 195, 200);
}

.enemy-bar__stagger {
    height: 5px;
    margin-top: 1px;
    overflow: hidden;
    background-color: rgba(10, 12, 10, 0.85);
    border-width: 1px;
    border-color: rgba(0, 0, 0, 0.9);
}

.enemy-bar__stagger-fill {
    background-color: rgb(255, 176, 0);
}

.hud__prompt {
    position: absolute;
    bottom: 22%;
    align-self: center;
    padding: 6px 18px;
    font-size: 26px;
    color: rgb(230, 240, 235);
    background-color: rgba(10, 12, 14, 0.7);
    border-radius: 4px;
    -unity-text-align: middle-center;
}

.hud__prompt--hidden {
    display: none;
}

.hud__saving {
    position: absolute;
    right: 40px;
    bottom: 40px;
    width: 28px;
    height: 28px;
    border-radius: 14px;
    border-width: 4px;
    border-color: rgb(80, 220, 180);
    background-color: rgba(80, 220, 180, 0.25);
    opacity: 0;
    scale: 0.6 0.6;
    transition-property: opacity, scale;
    transition-duration: 0.25s, 0.25s;
}

.hud__saving--visible {
    opacity: 1;
    scale: 1 1;
}

.hud__status {
    position: absolute;
    bottom: 96px;
    left: 50%;
    translate: -50% 0;
    flex-direction: row;
}

.hud__status-icon {
    width: 26px;
    height: 26px;
    margin: 0 4px;
    border-radius: 6px;
    border-width: 3px;
    display: none;
}

.hud__status-icon--active {
    display: flex;
}

.hud__status-icon--slow {
    border-color: rgb(150, 110, 255);
    background-color: rgba(150, 110, 255, 0.35);
}

.hud__status-icon--root {
    border-color: rgb(255, 200, 60);
    background-color: rgba(255, 200, 60, 0.35);
    rotate: 45deg;
}

.hud__boss {
    position: absolute;
    top: 40px;
    left: 50%;
    width: 900px;
    translate: -50% 0;
    transition-property: opacity;
    transition-duration: 0.4s;
}

.hud__boss--hidden {
    opacity: 0;
}

.hud__boss-name {
    font-size: 24px;
    color: rgb(235, 220, 200);
    -unity-font-style: bold;
    margin-bottom: 4px;
    padding: 0;
}

.hud-bar--boss {
    height: 16px;
}

.hud-bar--boss .hud-bar__fill {
    background-color: rgb(185, 28, 48);
}

.hud-bar--boss-stagger {
    height: 6px;
    margin-top: 3px;
}

.hud-bar--boss-stagger .hud-bar__fill {
    background-color: rgb(235, 190, 60);
}

.hud__boss--stunned .hud-bar--boss-stagger .hud-bar__fill {
    background-color: rgb(150, 210, 255);
}

.hud__boss-tick {
    position: absolute;
    top: 0;
    bottom: 0;
    width: 2px;
    background-color: rgba(255, 240, 220, 0.8);
}

.hud__reward {
    position: absolute;
    top: 30%;
    align-self: center;
    padding: 10px 28px;
    font-size: 34px;
    color: rgb(255, 235, 180);
    -unity-font-style: bold;
    background-color: rgba(20, 8, 4, 0.75);
    border-radius: 4px;
    opacity: 0;
    transition-property: opacity;
    transition-duration: 0.5s;
}

.hud__reward--shown {
    opacity: 1;
}

.hud__status-icon--stun {
    border-color: rgb(150, 210, 255);
    background-color: rgba(150, 210, 255, 0.35);
    border-radius: 13px;
}

.hud__loadout {
    position: absolute;
    bottom: 44px;
    left: 50%;
    translate: 300px 0;
    flex-direction: row;
    align-items: flex-end;
}

.hud__slot {
    width: 54px;
    height: 54px;
    margin-left: 6px;
    background-color: rgba(6, 8, 6, 0.6);
    border-width: 2px;
    border-color: rgb(110, 84, 24);
    border-radius: 4px;
    align-items: center;
    justify-content: center;
}

.hud__slot--ability {
    width: 62px;
    height: 62px;
    margin-left: 12px;
    border-color: rgb(30, 160, 145);
    transition-property: border-color, background-color;
    transition-duration: 0.15s;
}

.hud__slot--ready {
    border-color: rgb(80, 255, 225);
    background-color: rgba(30, 160, 145, 0.35);
}

.hud__slot--active {
    background-color: rgba(80, 255, 225, 0.6);
}

.hud__slot--empty {
    opacity: 0.35;
}

.hud__slot-label {
    font-size: 20px;
    -unity-font-style: bold;
    color: rgb(235, 225, 200);
    padding: 0;
}

.hud__slot-key {
    position: absolute;
    right: 3px;
    bottom: 1px;
    font-size: 11px;
    color: rgba(235, 225, 200, 0.6);
    padding: 0;
}

.hud__biomass {
    position: absolute;
    bottom: 44px;
    left: 50%;
    translate: -420px 0;
    flex-direction: row;
    align-items: center;
}

.hud__biomass-icon {
    width: 18px;
    height: 18px;
    border-radius: 9px;
    background-color: rgb(200, 60, 110);
    border-width: 2px;
    border-color: rgb(255, 150, 190);
}

.hud__biomass-count {
    font-size: 24px;
    -unity-font-style: bold;
    color: rgb(240, 225, 230);
    margin-left: 6px;
    padding: 0;
}

.hud__biomass-delta {
    position: absolute;
    left: 24px;
    bottom: 28px;
    font-size: 20px;
    -unity-font-style: bold;
    opacity: 0;
    translate: 0 8px;
    transition-property: opacity, translate;
    transition-duration: 0.25s;
    padding: 0;
}

.hud__biomass-delta--shown {
    opacity: 1;
    translate: 0 0;
}

.hud__biomass-delta--gain {
    color: rgb(140, 240, 120);
}

.hud__biomass-delta--loss {
    color: rgb(255, 90, 90);
}
