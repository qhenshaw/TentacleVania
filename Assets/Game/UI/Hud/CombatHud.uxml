<ui:UXML xmlns:ui="UnityEngine.UIElements">
    <Style src="CombatHud.uss" />
    <ui:VisualElement name="hud" class="hud" picking-mode="Ignore">
        <ui:VisualElement name="enemy-layer" class="hud__layer" picking-mode="Ignore" />
        <ui:VisualElement name="saving" class="hud__saving" picking-mode="Ignore" />
        <ui:VisualElement name="boss" class="hud__boss hud__boss--hidden" picking-mode="Ignore">
            <ui:Label name="boss-name" class="hud__boss-name" picking-mode="Ignore" />
            <ui:VisualElement name="boss-health" class="hud-bar hud-bar--boss" picking-mode="Ignore">
                <ui:VisualElement name="boss-trail" class="hud-bar__layer hud-bar__trail" picking-mode="Ignore" />
                <ui:VisualElement name="boss-fill" class="hud-bar__layer hud-bar__fill" picking-mode="Ignore" />
                <ui:VisualElement name="boss-ticks" class="hud-bar__ticks" picking-mode="Ignore" />
            </ui:VisualElement>
            <ui:VisualElement name="boss-stagger" class="hud-bar hud-bar--boss-stagger" picking-mode="Ignore">
                <ui:VisualElement name="boss-stagger-fill" class="hud-bar__layer hud-bar__fill" picking-mode="Ignore" />
            </ui:VisualElement>
        </ui:VisualElement>
        <ui:Label name="reward" class="hud__reward" picking-mode="Ignore" />
        <ui:VisualElement name="subtitle" class="hud__subtitle" picking-mode="Ignore">
            <ui:Label name="subtitle-speaker" class="hud__subtitle-speaker" picking-mode="Ignore" />
            <ui:Label name="subtitle-text" class="hud__subtitle-text" picking-mode="Ignore" />
        </ui:VisualElement>
        <ui:Label name="prompt" class="hud__prompt hud__prompt--hidden" picking-mode="Ignore" />
        <ui:VisualElement name="status-icons" class="hud__status" picking-mode="Ignore">
            <ui:VisualElement name="status-slow" class="hud__status-icon hud__status-icon--slow" picking-mode="Ignore" />
            <ui:VisualElement name="status-root" class="hud__status-icon hud__status-icon--root" picking-mode="Ignore" />
            <ui:VisualElement name="status-stun" class="hud__status-icon hud__status-icon--stun" picking-mode="Ignore" />
            <ui:VisualElement name="status-bleed" class="hud__status-icon hud__status-icon--bleed" picking-mode="Ignore" />
            <ui:VisualElement name="status-burn" class="hud__status-icon hud__status-icon--burn" picking-mode="Ignore" />
            <ui:VisualElement name="status-corrode" class="hud__status-icon hud__status-icon--corrode" picking-mode="Ignore" />
        </ui:VisualElement>
        <ui:VisualElement name="loadout" class="hud__loadout" picking-mode="Ignore">
            <ui:VisualElement name="slot-weapon1" class="hud__slot hud__slot--weapon" picking-mode="Ignore">
                <ui:Label name="slot-weapon1-label" class="hud__slot-label" picking-mode="Ignore" />
                <ui:Label name="slot-weapon1-key" class="hud__slot-key" picking-mode="Ignore" />
            </ui:VisualElement>
            <ui:VisualElement name="slot-weapon2" class="hud__slot hud__slot--weapon" picking-mode="Ignore">
                <ui:Label name="slot-weapon2-label" class="hud__slot-label" picking-mode="Ignore" />
                <ui:Label name="slot-weapon2-key" class="hud__slot-key" picking-mode="Ignore" />
            </ui:VisualElement>
            <ui:VisualElement name="slot-ability" class="hud__slot hud__slot--ability" picking-mode="Ignore">
                <ui:Label name="slot-ability-label" class="hud__slot-label" picking-mode="Ignore" />
                <ui:Label name="slot-ability-key" class="hud__slot-key" picking-mode="Ignore" />
            </ui:VisualElement>
        </ui:VisualElement>
        <ui:VisualElement name="biomass" class="hud__biomass" picking-mode="Ignore">
            <ui:VisualElement class="hud__biomass-icon" picking-mode="Ignore" />
            <ui:Label name="biomass-count" class="hud__biomass-count" picking-mode="Ignore" />
            <ui:Label name="biomass-delta" class="hud__biomass-delta" picking-mode="Ignore" />
        </ui:VisualElement>
        <ui:VisualElement name="player" class="hud__player" picking-mode="Ignore">
            <ui:VisualElement name="health" class="hud-bar hud-bar--health" picking-mode="Ignore">
                <ui:VisualElement name="health-trail" class="hud-bar__layer hud-bar__trail" picking-mode="Ignore" />
                <ui:VisualElement name="health-heal" class="hud-bar__layer hud-bar__heal" picking-mode="Ignore" />
                <ui:VisualElement name="health-fill" class="hud-bar__layer hud-bar__fill" picking-mode="Ignore" />
                <ui:VisualElement name="health-ticks" class="hud-bar__ticks" picking-mode="Ignore" />
            </ui:VisualElement>
            <ui:VisualElement name="charge" class="hud-bar hud-bar--charge" picking-mode="Ignore">
                <ui:VisualElement name="charge-fill" class="hud-bar__layer hud-bar__fill" picking-mode="Ignore" />
                <ui:VisualElement name="charge-glow" class="hud-bar__glow" picking-mode="Ignore" />
            </ui:VisualElement>
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>
