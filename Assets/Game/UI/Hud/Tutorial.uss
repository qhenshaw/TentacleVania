.tutorial-root {
    position: absolute;
    left: 0;
    right: 0;
    bottom: 230px;
    align-items: center;
}

.tutorial {
    padding: 10px 26px;
    background-color: rgba(4, 14, 8, 0.85);
    border-width: 2px;
    border-color: rgb(60, 200, 110);
    border-radius: 4px;
    opacity: 0;
    translate: 0 12px;
    transition-property: opacity, translate;
    transition-duration: 0.25s;
}

.tutorial--shown {
    opacity: 1;
    translate: 0 0;
}

.tutorial__text {
    font-size: 26px;
    color: rgb(190, 255, 210);
}
