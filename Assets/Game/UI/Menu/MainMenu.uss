.main-menu {
    flex-grow: 1;
    align-items: center;
    justify-content: center;
    background-color: rgb(10, 6, 12);
}

.main-menu__title {
    font-size: 72px;
    -unity-font-style: bold;
    letter-spacing: 8px;
    color: rgb(170, 40, 90);
    margin-bottom: 64px;
}

.main-menu__buttons {
    width: 320px;
}

.main-menu--hidden {
    display: none;
}

.main-menu__button {
    height: 56px;
    margin: 6px 0;
    font-size: 26px;
    color: rgb(220, 200, 210);
    background-color: rgb(32, 18, 30);
    border-width: 2px;
    border-color: rgb(80, 30, 60);
    border-radius: 4px;
}

.main-menu__button:hover,
.main-menu__button:focus {
    background-color: rgb(70, 20, 50);
    border-color: rgb(200, 50, 110);
}

.main-menu__button:disabled {
    opacity: 0.5;
}

.main-menu__slots {
    width: 900px;
}

.main-menu__slots-title {
    font-size: 34px;
    -unity-font-style: bold;
    color: rgb(220, 200, 210);
    margin-bottom: 16px;
    -unity-text-align: middle-center;
}

.main-menu__slot-row {
    flex-direction: row;
    margin: 4px 0;
}

.main-menu__slot {
    flex-grow: 1;
    height: 88px;
    margin: 0 8px 0 0;
    padding: 8px 18px;
    flex-direction: column;
    align-items: flex-start;
    justify-content: center;
    background-color: rgb(32, 18, 30);
    border-width: 2px;
    border-color: rgb(80, 30, 60);
    border-radius: 4px;
}

.main-menu__slot:hover,
.main-menu__slot:focus {
    background-color: rgb(70, 20, 50);
    border-color: rgb(200, 50, 110);
}

.main-menu__slot:disabled {
    opacity: 0.45;
}

.main-menu__slot-name {
    font-size: 26px;
    -unity-font-style: bold;
    color: rgb(230, 210, 220);
}

.main-menu__slot-details {
    font-size: 20px;
    color: rgb(170, 140, 160);
}

.main-menu__slot-delete {
    width: 140px;
    height: 88px;
    margin: 0;
    font-size: 20px;
}

.main-menu__back {
    align-self: center;
    width: 320px;
    margin-top: 18px;
}

.main-menu__confirm {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    align-items: center;
    justify-content: center;
    background-color: rgba(4, 2, 6, 0.8);
}

.main-menu__dialog {
    width: 720px;
    padding: 28px 32px;
    background-color: rgb(20, 10, 18);
    border-width: 2px;
    border-color: rgb(200, 50, 110);
}

.main-menu__confirm-text {
    font-size: 26px;
    color: rgb(230, 210, 220);
    white-space: normal;
    -unity-text-align: middle-center;
    margin-bottom: 22px;
}

.main-menu__dialog-buttons {
    flex-direction: row;
    justify-content: center;
}

.main-menu__dialog-button {
    width: 240px;
    margin: 0 10px;
}
