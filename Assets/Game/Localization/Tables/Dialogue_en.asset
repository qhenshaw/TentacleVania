  m_Script: {fileID: 11500000, guid: e9620f8c34305754d8cc9a7e49e852d9, type: 3}
  m_Name: Dialogue_en
  m_EditorClassIdentifier: Unity.Localization::UnityEngine.Localization.Tables.StringTable
  m_LocaleId:
    m_Code: en
  m_SharedData: {fileID: 11400000, guid: 2f0ee082b9462944eaa7a29918420727, type: 2}
  m_Metadata:
    m_Items: []
  m_TableData:
  - m_Id: 672940032
    m_Localized: Attention. Containment failure, Pod Row 3. Holding is on lockdown. All personnel to the nearest secure room.
    m_Metadata:
      m_Items: []
  - m_Id: 714883072
    m_Localized: Handler teams to Row 3. Sedation rounds authorized. Do not engage alone.
    m_Metadata:
      m_Items: []
  - m_Id: 714883073
    m_Localized: Holding is sealed. Nothing leaves that block. Nothing.
    m_Metadata:
      m_Items: []
  - m_Id: 714883074
    m_Localized: Warden unit offline in Holding. Repeat, the Warden is down.
    m_Metadata:
      m_Items: []
  - m_Id: 723271680
    m_Localized: It went through the Warden like it was nothing. Pull everyone back. Now.
    m_Metadata:
      m_Items: []
  - m_Id: 723271681
    m_Localized: So. You're awake.
    m_Metadata:
      m_Items: []
  - m_Id: 723271682
    m_Localized: I know what woke you. She calls to all of you. None of the others ever answered.
    m_Metadata:
      m_Items: []
  - m_Id: 723271683
    m_Localized: That drone was built to hold you. Nothing here was built to hold you for long. I learned that once already.
    m_Metadata:
      m_Items: []
  - m_Id: 723271684
    m_Localized: Go back to your pod, and I'll make this painless. Go down, and I won't.
    m_Metadata:
      m_Items: []
  - m_Id: 723271685
    m_Localized: Bio-Labs, this is Security. Specimen breach on Level 1. Lock the theatres and stay inside.
    m_Metadata:
      m_Items: []
  - m_Id: 723271686
    m_Localized: 'All surgical staff: secure your samples first. Then yourselves.'
    m_Metadata:
      m_Items: []
  - m_Id: 723271687
    m_Localized: Med-Drones deploying to Bio-Labs. Lab Security, hold the corridors.
    m_Metadata:
      m_Items: []
  - m_Id: 723271688
    m_Localized: The Automaton in Theatre 1 is not responding. Containment, confirm status.
    m_Metadata:
      m_Items: []
  - m_Id: 723271689
    m_Localized: Theatre 1 is gone. The Automaton's gone. It's heading for the lower levels.
    m_Metadata:
      m_Items: []
  - m_Id: 723271690
    m_Localized: 'All stations: specimen moving between levels. Seal the stairwells. Seal everything.'
    m_Metadata:
      m_Items: []
  - m_Id: 723271691
    m_Localized: Warning. Security relay offline, {0}. One of three.
    m_Metadata:
      m_Items: []
  - m_Id: 723271692
    m_Localized: Second security relay offline, {0}. Boss containment door at reduced power.
    m_Metadata:
      m_Items: []
  - m_Id: 723271693
    m_Localized: All security relays offline, {0}. Containment door unsealed.
    m_Metadata:
      m_Items: []
  - m_Id: 723271694
    m_Localized: That machine opened up dozens of your kind. I suppose that makes this personal.
    m_Metadata:
      m_Items: []
  - m_Id: 723271695
    m_Localized: You're going down. Toward her. Of course you are.
    m_Metadata:
      m_Items: []
  - m_Id: 723271696
    m_Localized: Every level below this one was built for things worse than you. Keep going. Let's see what you become.
    m_Metadata:
      m_Items: []
  - m_Id: 723271697
    m_Localized: Specimen Holding
    m_Metadata:
      m_Items: []
  - m_Id: 723271698
    m_Localized: Bio-Labs
    m_Metadata:
      m_Items: []
  - m_Id: 723271699
    m_Localized: Test Sector
    m_Metadata:
      m_Items: []
  - m_Id: 723271700
    m_Localized: PA
    m_Metadata:
      m_Items: []
  - m_Id: 723271701
    m_Localized: RADIO
    m_Metadata:
      m_Items: []
  - m_Id: 723271702
    m_Localized: DR. CRANE
    m_Metadata:
      m_Items: []
  references:
    version: 2
    RefIds: []
